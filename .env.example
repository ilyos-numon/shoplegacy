SHOPLEGACY_PROVIDER=fake
SHOPLEGACY_STT_PROVIDER=fake
SHOPLEGACY_DATA_DIR=./data
SHOPLEGACY_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
SHOPLEGACY_LLM_MODEL=qwen3.7-flash
SHOPLEGACY_LLM_API_KEY=
SHOPLEGACY_LLM_TIMEOUT=20.0
SHOPLEGACY_WHISPER_MODEL=small
SHOPLEGACY_STT_MAX_BYTES=26214400
SHOPLEGACY_SESSION_SECONDS=1200
SHOPLEGACY_SESSIONS_PLANNED=5

SHOPLEGACY_DATABASE_URL=postgresql://shoplegacy_app:shoplegacy_app@localhost:56322/postgres
SHOPLEGACY_JWT_SECRET=
SHOPLEGACY_JWKS_URL=
SHOPLEGACY_JWT_AUDIENCE=authenticated
SHOPLEGACY_SUPABASE_URL=http://localhost:56321
SHOPLEGACY_SUPABASE_ANON_KEY=
SHOPLEGACY_MIN_SUPPORTED_RATIO=0.8
SHOPLEGACY_REQUIRE_ALL_AXES=false
SHOPLEGACY_REQUIRE_CONSENT=true
SHOPLEGACY_RATE_LIMIT=60/minute
SHOPLEGACY_LOG_FORMAT=console
SHOPLEGACY_SENTRY_DSN=
# 테스트 전용
SHOPLEGACY_TEST_PG_DSN=postgresql://postgres:postgres@localhost:56322/postgres
SHOPLEGACY_TEST_DB_PREFIX=sl_test

# --- 개인정보 암호화·보관·관측·사장님 링크 ---
# 쉼표로 구분한 Fernet 키 (첫 키로 암호화, 나머지는 복호화 전용). 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHOPLEGACY_PII_KEYS=
SHOPLEGACY_RETENTION_DAYS=1095
# none | presidio  (presidio 는 uv sync --extra ner 필요)
SHOPLEGACY_NER=none
SHOPLEGACY_NER_MODEL=ko_core_news_md
SHOPLEGACY_OTEL_ENDPOINT=
SHOPLEGACY_OTEL_SERVICE_NAME=shoplegacy
# 쉼표로 구분한 신뢰 프록시 IP/CIDR. 비우면 X-Forwarded-For 를 무시한다
SHOPLEGACY_TRUSTED_PROXIES=
SHOPLEGACY_CSP_REPORT_ONLY=false
# log | solapi  (solapi 는 uv sync --extra sms 와 계정 필요)
SHOPLEGACY_SMS_PROVIDER=log
SHOPLEGACY_SMS_API_KEY=
SHOPLEGACY_SMS_API_SECRET=
SHOPLEGACY_SMS_FROM=
SHOPLEGACY_OWNER_LINK_TTL_HOURS=72
SHOPLEGACY_REQUIRE_OWNER_APPROVAL=false
SHOPLEGACY_PUBLIC_BASE_URL=http://localhost:8830
SHOPLEGACY_REPORT_MAX_ROWS=10000
