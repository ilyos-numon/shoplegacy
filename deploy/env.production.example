# 운영(Cloud Run) 환경변수 전체 목록. 값은 비워 둔다 — 이 파일에 실제 값을 적어 커밋하지 않는다.
# 복사해서 쓴다: cp deploy/env.production.example .env.production (.env.production 은 커밋하지 않는다)
# 구역(# === 로 시작하는 줄)은 scripts/check_deploy.py 와 deploy/gcp/apply-env.sh 가 읽는다. 구역 이름을 바꾸지 않는다.
#   SECRET  Secret Manager 비밀 → Cloud Run secretKeyRef (비밀 이름 = 변수 이름, 버전 latest). deploy/gcp/apply-env.sh 가 넣는다
#   ENV     Cloud Run 평문 env (deploy/gcp/service.yaml 의 env). 공개돼도 되는 값만. 비우면 service.yaml 기본값
#   DEPLOY  앱이 읽지 않는다. deploy/gcp/setup.sh·deploy/gcp/apply-env.sh 입력과 GitHub Actions vars
#   UNUSED  운영에서는 비워 두는 변수 (로컬·테스트·선택 기능 전용). 여기 적힌 것은 service.yaml 에 넣지 않는다

# === SECRET
# 업무 DB 주소. 비워 둔다 — apply-env.sh 가 앱 로그인 역할(shoplegacy_app) 비밀번호를 새로 정하고
# postgresql://shoplegacy_app.<project-ref>:<비밀번호>@<Session pooler 호스트>:5432/postgres 로 만든다.
# 직접 연결 주소는 IPv6 전용이라 Cloud Run 에서 안 됨. 트랜잭션 풀러(6543) 금지 (SET LOCAL ROLE·작업 대기열 LISTEN 이 세션을 쓴다)
SHOPLEGACY_DATABASE_URL=
# 앱 자체 서명 비밀 (사장님 확인 링크 등). 비우면 버전이 없을 때만 무작위 값을 만든다.
# 로그인 토큰은 SHOPLEGACY_JWKS_URL(비대칭 키)로 검증하므로 Supabase JWT 비밀을 넣지 않는다
SHOPLEGACY_JWT_SECRET=
# 피드백 링크 서명 비밀. 비우면 버전이 없을 때만 무작위 값을 만든다
SHOPLEGACY_FEEDBACK_SECRET=
# 개인정보 암호화 키 (Fernet, 쉼표로 여러 개 = 키 교체). 비우면 버전이 없을 때만 새 키를 만든다. 잃어버리면 암호화된 값을 못 읽는다
SHOPLEGACY_PII_KEYS=
# OpenAI 호환 LLM API 키 (필수)
SHOPLEGACY_LLM_API_KEY=
# 토스페이먼츠 시크릿 키. 운영 데모는 결제 가짜(fake)라 비워 둔다 (버전이 없을 때만 unused)
SHOPLEGACY_TOSS_SECRET_KEY=

# === ENV
# 공개 주소 (https://<도메인>, <도메인> = Cloud Run 서비스 URL 호스트). 사장님 확인 링크·피드백 링크 기준.
# 비우면 apply-env.sh 가 https://<서비스>-<PROJECT_NUMBER>.<리전>.run.app 로 채운다
SHOPLEGACY_PUBLIC_BASE_URL=
# LLM 공급자 (fake·qwen). 운영 qwen
SHOPLEGACY_PROVIDER=
# LLM API 주소(/v1 까지)·모델·제한 시간(초)
SHOPLEGACY_LLM_BASE_URL=
SHOPLEGACY_LLM_MODEL=
SHOPLEGACY_LLM_TIMEOUT=
# 음성 인식 (fake·whisper). 운영 데모는 fake (인스턴스 512Mi 에 모델을 올리지 않는다)
SHOPLEGACY_STT_PROVIDER=
# 작업 대기열(procrastinate) 워커 위치 (thread·external·off). 운영 thread = 앱 안 스레드 (요청 처리 중에만 CPU)
SHOPLEGACY_STT_WORKER=
# 음성 업로드 최대 바이트·실시간 받아쓰기 최대 초·동시 수
SHOPLEGACY_STT_MAX_BYTES=
SHOPLEGACY_STT_STREAM_MAX_SECONDS=
SHOPLEGACY_STT_STREAM_MAX_CONCURRENT=
# 로그인 토큰 검증 공개키 주소·audience. 비우면 apply-env.sh 가 SUPABASE_URL 로 채운다
SHOPLEGACY_JWKS_URL=
SHOPLEGACY_JWT_AUDIENCE=
# 로그인 화면이 쓰는 Supabase 주소·anon(공개) 키. 비우면 apply-env.sh 가 SUPABASE_URL·SUPABASE_ANON_KEY 로 채운다
SHOPLEGACY_SUPABASE_URL=
SHOPLEGACY_SUPABASE_ANON_KEY=
# 신뢰할 프록시 (X-Forwarded-For). Cloud Run 은 *
SHOPLEGACY_TRUSTED_PROXIES=
# 로그 형식 (console·json). 운영 json (Cloud Logging)
SHOPLEGACY_LOG_FORMAT=
# 오류 수집 주소 (비우면 끔)
SHOPLEGACY_SENTRY_DSN=
# 녹음 전 동의 확인
SHOPLEGACY_REQUIRE_CONSENT=
# 요청 속도 제한
SHOPLEGACY_RATE_LIMIT=
# CSP 위반을 막지 않고 보고만
SHOPLEGACY_CSP_REPORT_ONLY=
# 결제 (fake·toss). 운영 데모 fake
SHOPLEGACY_BILLING_PROVIDER=
# 토스 클라이언트 키 (브라우저용 공개 키)
SHOPLEGACY_TOSS_CLIENT_KEY=
# 문자 발송 (log·solapi). 운영 데모 log (실제 발송 없음)
SHOPLEGACY_SMS_PROVIDER=
# 개인정보 이름 인식 (none·presidio). 운영 none
SHOPLEGACY_NER=
# 데이터 폴더·녹음 저장소 (Cloud Run 은 인스턴스 안 임시 디스크: 인스턴스가 내려가면 지워진다)
SHOPLEGACY_DATA_DIR=
SHOPLEGACY_AUDIO_STORE=
# 인터뷰 한 회 시간(초)·계획 회차
SHOPLEGACY_SESSION_SECONDS=
SHOPLEGACY_SESSIONS_PLANNED=
# 사장님 확인 링크 유효 시간·승인 필수 여부
SHOPLEGACY_OWNER_LINK_TTL_HOURS=
SHOPLEGACY_REQUIRE_OWNER_APPROVAL=
# 보관 기간(일, 30 이상)
SHOPLEGACY_RETENTION_DAYS=

# === DEPLOY
# GCP 프로젝트 ID (apply-env.sh 필수)
GCP_PROJECT_ID=
# 리전. 비우면 asia-northeast3
GCP_REGION=
# Supabase Session pooler 주소 (postgres 계정, …pooler.supabase.com:5432). apply-env.sh 가 마이그레이션·shoplegacy_app 비밀번호 설정에 쓴다. Direct 주소는 IPv6 전용이라 안 됨
SUPABASE_POOLER_URL=
# WIF 프로바이더 전체 이름 (projects/<PROJECT_NUMBER>/locations/global/workloadIdentityPools/github-pool/providers/github-provider). setup.sh 가 출력
GCP_WIF_PROVIDER=
# 배포용 서비스 계정 이메일 (shoplegacy-deploy@<PROJECT_ID>.iam.gserviceaccount.com). setup.sh 가 출력
GCP_DEPLOY_SA=
# Cloud Run 서비스 이름. shoplegacy
CLOUD_RUN_SERVICE=
# Artifact Registry 저장소 이름. shoplegacy
ARTIFACT_REPO=
# WIF 조건에 넣을 GitHub 저장소 (<owner>/<repo>). setup.sh 입력 전용
GITHUB_REPO=
# Supabase 프로젝트 주소 (https://<project-ref>.supabase.co). apply-env.sh 가 SHOPLEGACY_SUPABASE_URL·SHOPLEGACY_JWKS_URL 로 렌더
SUPABASE_URL=
# Supabase anon(공개) 키 (sb_publishable_… 새 형식 가능, JWT 가 아니므로 해석하지 않는다). apply-env.sh 가 SHOPLEGACY_SUPABASE_ANON_KEY 로 렌더
# (SUPABASE_SERVICE_ROLE_KEY 가 .env.production 에 있어도 이 앱은 쓰지 않는다. 비밀로 올리지 않는다)
SUPABASE_ANON_KEY=

# === UNUSED
# 문자 발송 solapi 전용 (운영 데모는 log)
SHOPLEGACY_SMS_API_KEY=
SHOPLEGACY_SMS_API_SECRET=
SHOPLEGACY_SMS_FROM=
# 녹음 S3 저장소 전용 (운영 데모는 file://)
SHOPLEGACY_AUDIO_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# OpenTelemetry 전용 (운영 데모는 끔)
SHOPLEGACY_OTEL_ENDPOINT=
SHOPLEGACY_OTEL_SERVICE_NAME=
# whisper·presidio 모델 (운영 데모는 fake·none)
SHOPLEGACY_WHISPER_MODEL=
SHOPLEGACY_NER_MODEL=
# 토스 API 주소 (결제 fake 라 안 씀)
SHOPLEGACY_TOSS_API_BASE=
# 테스트 전용
SHOPLEGACY_TEST_PG_DSN=
SHOPLEGACY_TEST_DB_PREFIX=
# 코드 기본값을 그대로 쓴다
SHOPLEGACY_MIN_SUPPORTED_RATIO=
SHOPLEGACY_REQUIRE_ALL_AXES=
SHOPLEGACY_REPORT_MAX_ROWS=
